
pipeline {
    agent any

    environment {
        AWS_REGION = 'ap-south-1'
        S3_BUCKET = 'YOUR_ACTUAL_S3_BUCKET_NAME'
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Downloading CloudCart from GitHub'
            }
        }

        stage('Verify Files') {
            steps {
                sh '''
                    test -f index.html
                    test -f style.css
                    test -f script.js
                    echo "Website files verified"
                '''
            }
        }

        stage('Deploy to S3') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-cloudcart-credentials'
                ]]) {
                    sh '''
                        export AWS_DEFAULT_REGION=$AWS_REGION
                        /usr/bin/aws s3 sync . s3://$S3_BUCKET/ \
                            --exclude ".git/*" \
                            --exclude "Jenkinsfile"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'CloudCart successfully deployed to AWS S3!'
        }
        failure {
            echo 'CloudCart deployment failed. Check Console Output.'
        }
    }
}
